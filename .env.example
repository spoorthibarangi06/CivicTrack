# CivicTrack Karnataka Configuration Template (.env.example)

ENVIRONMENT=development
DEBUG=True

PROJECT_NAME="CivicTrack Karnataka"
API_V1_STR="/api"

DATABASE_URL=sqlite:///./civictrack.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civictrack_karnataka

SECRET_KEY=generate_a_secure_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CivicTrackAdmin2026!
ADMIN_EMAIL=admin@civictrack.karnataka.gov.in

HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=3000

# Government API Credentials
# Registered API key from https://data.gov.in/ for Open Government Data India
DATA_GOV_IN_API_KEY=your_api_key_here

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
